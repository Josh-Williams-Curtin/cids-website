---
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const navItems = [
	{ href: base, label: "Home" },
	{ href: `${base}/about`, label: "About" },
	{ href: `${base}/blog`, label: "Blog" },
	{ href: `${base}/contact`, label: "Contact" },
];

function stripTrailingSlash(path: string) {
	return path !== "/" && path.endsWith("/") ? path.slice(0, -1) : path;
}

const normalizedCurrent = stripTrailingSlash(currentPath);
const normalizedBase = stripTrailingSlash(base);

function isActive(href: string) {
	const normalizedHref = stripTrailingSlash(href);
	const isHome = normalizedHref === normalizedBase;
	const isExactMatch = normalizedCurrent === normalizedHref;
	const isNestedMatch = normalizedCurrent.startsWith(`${normalizedHref}/`);

	if (isHome) {
		return isExactMatch;
	} else {
		return isExactMatch || isNestedMatch;
	}
}
---

<header class="border-b border-border">
	<div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
		<a href={base} class="text-lg font-bold text-primary">CIDS</a>
		<nav>
			<ul class="flex gap-6 text-sm font-medium">
				{
					navItems.map((item) => {
						const active = isActive(item.href);
						return (
							<li>
								<a
									href={item.href}
									aria-current={active ? "page" : undefined}
									class:list={[
										"transition-colors",
										active
											? "text-primary underline underline-offset-4"
											: "text-background-content hover:text-primary",
									]}
								>
									{item.label}
								</a>
							</li>
						);
					})
				}
			</ul>
		</nav>
	</div>
</header>
