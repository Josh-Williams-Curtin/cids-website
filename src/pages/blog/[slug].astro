---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
	<main class="mx-auto w-full max-w-5xl flex-1 px-4 py-12">
		<article>
			<header class="mb-8 border-b border-border pb-8">
				<a href="/blog" class="text-sm text-primary hover:underline">← Blog</a>
				<h1 class="mt-4 text-3xl font-bold text-primary">{post.data.title}</h1>
				<p class="mt-2 text-neutral">{post.data.description}</p>
				<time datetime={post.data.pubDate.toISOString()} class="mt-2 block text-sm text-neutral">
					{
						post.data.pubDate.toLocaleDateString('en-US', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
						})
					}
				</time>
			</header>
			<div
				class="space-y-4 text-background-content [&_a]:text-primary [&_a]:underline [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-semibold [&_p]:leading-relaxed"
			>
				<Content />
			</div>
		</article>
	</main>
</Layout>
