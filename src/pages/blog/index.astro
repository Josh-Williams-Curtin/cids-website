---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog">
	<main class="mx-auto w-full max-w-5xl flex-1 px-4 py-12">
		<h1 class="text-3xl font-bold text-primary">Blog</h1>
		<ul class="mt-8 divide-y divide-border">
			{
				posts.map((post) => (
					<li class="py-6">
						<a href={`${base}/blog/${post.id}`} class="group block">
							<h2 class="text-xl font-semibold group-hover:text-primary">
								{post.data.title}
							</h2>
							<p class="mt-1 text-neutral">{post.data.description}</p>
							<time
								datetime={post.data.pubDate.toISOString()}
								class="mt-2 block text-sm text-neutral"
							>
								{post.data.pubDate.toLocaleDateString("en-US", {
									year: "numeric",
									month: "long",
									day: "numeric",
								})}
							</time>
						</a>
					</li>
				))
			}
		</ul>
	</main>
</Layout>
